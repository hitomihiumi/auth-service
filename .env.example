# -------------- Auth Service environment --------------
#
# Only infrastructure roots live here. OAuth client ids and secrets are no
# longer environment variables: applications and their login providers are
# registered at runtime through the admin panel and stored encrypted in the
# database.

# --- Database ---
POSTGRES_USER=authsvc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auth_service
# Used by the backend directly; the host is the compose service name.
DATABASE_URL=postgresql://authsvc:change-me@postgres:5432/auth_service?schema=public

# --- Secret encryption ---
# Root key protecting every stored client secret and signing key.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Rotation form; supply instead of ENCRYPTION_KEY to keep several keys live.
# Re-wrap existing rows with: npm run secrets:rewrap
# ENCRYPTION_KEYS={"1":"<base64 key>","2":"<base64 key>"}
# ENCRYPTION_ACTIVE_KEY_ID=2

# --- Service URLs ---
# This service's public origin. Becomes the JWT `iss` and prefixes every
# provider callback URL, so changing it invalidates callbacks already
# registered with Google, Discord and the like.
PUBLIC_BASE_URL=http://localhost:4000
APP_PORT=4000

# Origin of the sign-in frontend. Only used by two-factor sign-ins: a login
# that owes a code is sent to <PUBLIC_APP_URL>/mfa to enter it. Leave it unset
# and the challenge is handed to the consumer application instead, which then
# has to collect the code and call POST /auth/mfa/verify itself.
PUBLIC_APP_URL=http://localhost:3430

# Browser origins allowed to call the API with credentials. Required in
# production — there is no wildcard fallback, because the admin panel
# authenticates with a cookie.
ALLOWED_ORIGINS=http://localhost:3430,http://localhost:5173

# --- First admin ---
# Consumed once by `npm run db:seed`; remove afterwards and change the password
# via POST /admin/auth/change-password.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=

# --- Frontend (build-time) ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3430

# --- Optional ---
# Serve Swagger at /docs in production too.
# ENABLE_SWAGGER=true
