# pnpm's default symlinked layout is kept deliberately: a package can only
# import what it declares, which is the main reason to be on pnpm at all.
# Anything that needs a flat tree (Docker runtime layers) gets one from
# `pnpm deploy` instead of weakening this for the whole repo.

# The frontend and test-app pull in overlapping React major versions; failing
# the install on peer ranges would block work the type checker already covers.
strict-peer-dependencies=false
