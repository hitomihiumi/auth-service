// Multi-tenant auth service schema.
//
// Every tenant is an Application. Provider credentials, redirect allowlists,
// signing keys and end users all hang off it, which is what allows a second
// application to be registered with its own OAuth credentials at runtime
// instead of at process boot.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts a connection URL here: migration tooling reads it
// from prisma.config.ts, and the runtime client receives a driver adapter.
datasource db {
  provider = "postgresql"
}

enum ProviderKind {
  GOOGLE
  DISCORD
  GITHUB
  OIDC // generic OpenID Connect provider
  OAUTH2 // generic OAuth2 provider with a userinfo endpoint

  @@map("provider_kind")
}

/// How strictly an application treats a second factor.
enum MfaPolicy {
  /// No second factor is ever asked for, and enrolment is refused.
  DISABLED
  /// Users may enrol; only those who did are challenged.
  OPTIONAL
  /// Every user must hold a confirmed factor; a login without one enrols first.
  REQUIRED

  @@map("mfa_policy")
}

enum AdminRole {
  OWNER
  ADMIN

  @@map("admin_role")
}

/// A tenant. Users, provider configs and redirect URIs all belong to exactly one.
model Application {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String
  description String?
  /// Public identifier handed to consumers; becomes the JWT `aud` claim.
  clientId    String  @unique @map("client_id")

  tokenTtlSeconds Int @default(3600) @map("token_ttl_seconds")

  /// When enabled, a new provider identity whose verified email matches an
  /// existing user of this application is linked to that user instead of being
  /// rejected. Off by default: for providers that do not verify email this is an
  /// account-takeover vector.
  allowEmailLinking Boolean @default(false) @map("allow_email_linking")

  /// Whether logins into this application ask for a TOTP code from an
  /// authenticator app (Google Authenticator, Authy, 1Password, and the like).
  mfaPolicy MfaPolicy @default(OPTIONAL) @map("mfa_policy")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  providers        ApplicationProvider[]
  redirectUris     ApplicationRedirectUri[]
  signingKeys      ApplicationSigningKey[]
  users            User[]
  authTransactions AuthTransaction[]
  mfaChallenges    MfaChallenge[]

  @@map("applications")
}

/// Exact-match allowlist for the post-login redirect target. Replaces passing the
/// target through the OAuth `state` parameter, which was an open redirect.
model ApplicationRedirectUri {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  /// Normalised absolute URI: origin + pathname, no query, no fragment.
  uri           String
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, uri])
  @@index([applicationId])
  @@map("application_redirect_uris")
}

/// One login button, with its own credentials. Per-application credentials are
/// the reason boot-time Passport strategy singletons had to go.
model ApplicationProvider {
  id            String       @id @default(uuid()) @db.Uuid
  applicationId String       @map("application_id") @db.Uuid
  kind          ProviderKind
  slug          String
  displayName   String       @map("display_name")
  /// Key into the frontend icon library.
  iconName      String?      @map("icon_name")
  sortOrder     Int          @default(0) @map("sort_order")
  isEnabled     Boolean      @default(true) @map("is_enabled")

  clientId              String   @map("client_id")
  /// Envelope-encrypted; never selected by any read that reaches a response.
  clientSecretEnc       String   @map("client_secret_enc")
  /// Display-only tail so admins can tell which secret is stored.
  clientSecretLast4     String   @map("client_secret_last4")
  clientSecretUpdatedAt DateTime @default(now()) @map("client_secret_updated_at")
  /// Overrides the preset default scopes when non-empty.
  scopes                String[]

  // Generic OIDC/OAUTH2 only; NULL for presets, which resolve from the catalog.
  authorizationUrl String? @map("authorization_url")
  tokenUrl         String? @map("token_url")
  userinfoUrl      String? @map("userinfo_url")
  issuer           String?

  /// GitHub OAuth Apps do not support PKCE, so this cannot be a constant.
  usePkce Boolean @default(true) @map("use_pkce")

  // Dotted claim paths into the userinfo payload; generic kinds only.
  claimSub      String? @default("sub") @map("claim_sub")
  claimEmail    String? @default("email") @map("claim_email")
  claimUsername String? @default("preferred_username") @map("claim_username")
  claimAvatar   String? @default("picture") @map("claim_avatar")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  identities       Identity[]
  authTransactions AuthTransaction[]
  mfaChallenges    MfaChallenge[]

  @@unique([applicationId, slug])
  @@index([applicationId, isEnabled])
  @@map("application_providers")
}

/// Per-application RSA signing key. Several rows per application so a rotation
/// can retire a key while already-issued tokens stay verifiable until they
/// expire. The public half is plaintext because it is served over JWKS.
model ApplicationSigningKey {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  /// JWT header `kid`.
  kid           String @unique
  algorithm     String @default("RS256")
  publicKeyPem  String @map("public_key_pem")
  privateKeyEnc String @map("private_key_enc")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  retiredAt DateTime? @map("retired_at")
  /// Stop publishing over JWKS after this instant (retirement + TTL + skew).
  expiresAt DateTime? @map("expires_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, isActive])
  @@map("application_signing_keys")
}

/// End user, scoped to a single application.
model User {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  /// Nullable: GitHub users can withhold their address.
  email         String?
  emailVerified Boolean @default(false) @map("email_verified")
  username      String?
  avatarUrl     String? @map("avatar_url")

  isBlocked   Boolean   @default(false) @map("is_blocked")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  identities      Identity[]
  totpCredentials TotpCredential[]
  recoveryCodes   MfaRecoveryCode[]
  mfaChallenges   MfaChallenge[]

  // Postgres treats NULLs as distinct, so many email-less users per app are fine.
  @@unique([applicationId, email])
  @@index([applicationId, createdAt])
  @@map("users")
}

/// Link between a local user and one provider account. This composite key is the
/// real natural key of a login, replacing the globally-unique email/providerId
/// pair that made a second provider on the same address a duplicate-key crash.
model Identity {
  id                    String @id @default(uuid()) @db.Uuid
  userId                String @map("user_id") @db.Uuid
  applicationProviderId String @map("application_provider_id") @db.Uuid
  providerAccountId     String @map("provider_account_id")

  /// Last userinfo payload, kept for debugging provider quirks.
  rawProfile Json? @map("raw_profile")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationProvider ApplicationProvider @relation(fields: [applicationProviderId], references: [id], onDelete: Cascade)

  @@unique([applicationProviderId, providerAccountId])
  @@index([userId])
  @@map("identities")
}

/// Server-side login transaction. The OAuth `state` is now an opaque handle to
/// this row rather than the caller-supplied redirect target.
model AuthTransaction {
  id                    String @id @default(uuid()) @db.Uuid
  state                 String @unique
  applicationId         String @map("application_id") @db.Uuid
  applicationProviderId String @map("application_provider_id") @db.Uuid

  codeVerifier        String  @map("code_verifier")
  codeChallengeMethod String  @default("S256") @map("code_challenge_method")
  nonce               String?

  /// Already validated against the allowlist when this row was written.
  redirectUri String @map("redirect_uri")

  /// Opaque value from the consumer app, echoed back untouched. Now that `state`
  /// belongs to us, this is where the consumer's own CSRF token lives.
  consumerState String? @map("consumer_state")

  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  application         Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationProvider ApplicationProvider @relation(fields: [applicationProviderId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("auth_transactions")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions AdminSession[]

  @@map("admin_users")
}

/// Opaque server-side session. Chosen over a JWT cookie so that logout and
/// lockout revoke immediately instead of waiting for expiry.
model AdminSession {
  id          String @id @default(uuid()) @db.Uuid
  adminUserId String @map("admin_user_id") @db.Uuid
  /// SHA-256 of the cookie value; the value itself is never stored.
  tokenHash   String @unique @map("token_hash")

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// A TOTP secret shared with one authenticator app (RFC 6238).
///
/// Several rows per user, because people register more than one device and
/// removing a phone should not lock out the tablet. A row only counts as a
/// factor once `confirmedAt` is set: enrolment is not finished until the user
/// has proved the app is actually generating matching codes.
model TotpCredential {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// User-supplied device name ("iPhone", "Authy"); shown when removing one.
  label  String

  /// Envelope-encrypted shared secret. Never selected by a read that reaches a
  /// response — after enrolment there is no reason to show it again.
  secretEnc String @map("secret_enc")

  // Google Authenticator ignores these three parameters in the enrolment URI
  // and always assumes SHA1/6/30, so the defaults have to match what it does.
  algorithm String @default("SHA1")
  digits    Int    @default(6)
  period    Int    @default(30)

  confirmedAt  DateTime? @map("confirmed_at")
  /// Highest time step already accepted. A code at or below it is refused, so a
  /// code observed over the user's shoulder cannot be replayed inside its window.
  lastUsedStep BigInt?   @map("last_used_step")
  lastUsedAt   DateTime? @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaChallenges MfaChallenge[]

  @@unique([userId, label])
  @@index([userId, confirmedAt])
  @@map("totp_credentials")
}

/// Single-use fallback for a lost authenticator app.
model MfaRecoveryCode {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  /// Argon2id digest. The code itself is shown once, at generation, and never
  /// stored — a database dump must not be a set of usable bypass codes.
  codeHash String @map("code_hash")

  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

/// A login that has passed the provider but still owes a second factor.
///
/// The token is issued only once this is consumed, so a stolen provider
/// callback is worth nothing on its own. It holds the already-validated
/// redirect target from the login transaction, for the same reason that
/// transaction does: nothing a caller supplies reaches the redirect unchecked.
model MfaChallenge {
  id        String @id @default(uuid()) @db.Uuid
  /// SHA-256 of the handle handed to the browser; the value itself is never stored.
  tokenHash String @unique @map("token_hash")

  applicationId         String @map("application_id") @db.Uuid
  userId                String @map("user_id") @db.Uuid
  applicationProviderId String @map("application_provider_id") @db.Uuid

  redirectUri   String  @map("redirect_uri")
  consumerState String? @map("consumer_state")

  /// Set when the challenge is an enrolment: the application requires a factor
  /// and this user has none yet, so the code confirms this pending credential.
  totpCredentialId String? @map("totp_credential_id") @db.Uuid

  /// Guessing budget. A six-digit code is only 20 bits, so the challenge — not
  /// the request rate — has to be what runs out.
  attempts Int @default(0)

  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  application         Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationProvider ApplicationProvider @relation(fields: [applicationProviderId], references: [id], onDelete: Cascade)
  totpCredential      TotpCredential?     @relation(fields: [totpCredentialId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([userId])
  @@map("mfa_challenges")
}
