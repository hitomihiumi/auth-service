// Multi-tenant auth service schema.
//
// Every tenant is an Application. Provider credentials, redirect allowlists,
// signing keys and end users all hang off it, which is what allows a second
// application to be registered with its own OAuth credentials at runtime
// instead of at process boot.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts a connection URL here: migration tooling reads it
// from prisma.config.ts, and the runtime client receives a driver adapter.
datasource db {
  provider = "postgresql"
}

enum ProviderKind {
  GOOGLE
  DISCORD
  GITHUB
  OIDC // generic OpenID Connect provider
  OAUTH2 // generic OAuth2 provider with a userinfo endpoint

  @@map("provider_kind")
}

enum AdminRole {
  OWNER
  ADMIN

  @@map("admin_role")
}

/// A tenant. Users, provider configs and redirect URIs all belong to exactly one.
model Application {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String
  description String?
  /// Public identifier handed to consumers; becomes the JWT `aud` claim.
  clientId    String  @unique @map("client_id")

  tokenTtlSeconds Int @default(3600) @map("token_ttl_seconds")

  /// When enabled, a new provider identity whose verified email matches an
  /// existing user of this application is linked to that user instead of being
  /// rejected. Off by default: for providers that do not verify email this is an
  /// account-takeover vector.
  allowEmailLinking Boolean @default(false) @map("allow_email_linking")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  providers        ApplicationProvider[]
  redirectUris     ApplicationRedirectUri[]
  signingKeys      ApplicationSigningKey[]
  users            User[]
  authTransactions AuthTransaction[]

  @@map("applications")
}

/// Exact-match allowlist for the post-login redirect target. Replaces passing the
/// target through the OAuth `state` parameter, which was an open redirect.
model ApplicationRedirectUri {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  /// Normalised absolute URI: origin + pathname, no query, no fragment.
  uri           String
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, uri])
  @@index([applicationId])
  @@map("application_redirect_uris")
}

/// One login button, with its own credentials. Per-application credentials are
/// the reason boot-time Passport strategy singletons had to go.
model ApplicationProvider {
  id            String       @id @default(uuid()) @db.Uuid
  applicationId String       @map("application_id") @db.Uuid
  kind          ProviderKind
  slug          String
  displayName   String       @map("display_name")
  /// Key into the frontend icon library.
  iconName      String?      @map("icon_name")
  sortOrder     Int          @default(0) @map("sort_order")
  isEnabled     Boolean      @default(true) @map("is_enabled")

  clientId String @map("client_id")
  /// Envelope-encrypted; never selected by any read that reaches a response.
  clientSecretEnc   String   @map("client_secret_enc")
  /// Display-only tail so admins can tell which secret is stored.
  clientSecretLast4 String   @map("client_secret_last4")
  clientSecretUpdatedAt DateTime @default(now()) @map("client_secret_updated_at")
  /// Overrides the preset default scopes when non-empty.
  scopes            String[]

  // Generic OIDC/OAUTH2 only; NULL for presets, which resolve from the catalog.
  authorizationUrl String? @map("authorization_url")
  tokenUrl         String? @map("token_url")
  userinfoUrl      String? @map("userinfo_url")
  issuer           String?

  /// GitHub OAuth Apps do not support PKCE, so this cannot be a constant.
  usePkce Boolean @default(true) @map("use_pkce")

  // Dotted claim paths into the userinfo payload; generic kinds only.
  claimSub      String? @default("sub") @map("claim_sub")
  claimEmail    String? @default("email") @map("claim_email")
  claimUsername String? @default("preferred_username") @map("claim_username")
  claimAvatar   String? @default("picture") @map("claim_avatar")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  identities       Identity[]
  authTransactions AuthTransaction[]

  @@unique([applicationId, slug])
  @@index([applicationId, isEnabled])
  @@map("application_providers")
}

/// Per-application RSA signing key. Several rows per application so a rotation
/// can retire a key while already-issued tokens stay verifiable until they
/// expire. The public half is plaintext because it is served over JWKS.
model ApplicationSigningKey {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  /// JWT header `kid`.
  kid           String @unique
  algorithm     String @default("RS256")
  publicKeyPem  String @map("public_key_pem")
  privateKeyEnc String @map("private_key_enc")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  retiredAt DateTime? @map("retired_at")
  /// Stop publishing over JWKS after this instant (retirement + TTL + skew).
  expiresAt DateTime? @map("expires_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, isActive])
  @@map("application_signing_keys")
}

/// End user, scoped to a single application.
model User {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  /// Nullable: GitHub users can withhold their address.
  email         String?
  emailVerified Boolean @default(false) @map("email_verified")
  username      String?
  avatarUrl     String? @map("avatar_url")

  isBlocked   Boolean   @default(false) @map("is_blocked")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  identities  Identity[]

  // Postgres treats NULLs as distinct, so many email-less users per app are fine.
  @@unique([applicationId, email])
  @@index([applicationId, createdAt])
  @@map("users")
}

/// Link between a local user and one provider account. This composite key is the
/// real natural key of a login, replacing the globally-unique email/providerId
/// pair that made a second provider on the same address a duplicate-key crash.
model Identity {
  id                    String @id @default(uuid()) @db.Uuid
  userId                String @map("user_id") @db.Uuid
  applicationProviderId String @map("application_provider_id") @db.Uuid
  providerAccountId     String @map("provider_account_id")

  /// Last userinfo payload, kept for debugging provider quirks.
  rawProfile Json? @map("raw_profile")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationProvider ApplicationProvider @relation(fields: [applicationProviderId], references: [id], onDelete: Cascade)

  @@unique([applicationProviderId, providerAccountId])
  @@index([userId])
  @@map("identities")
}

/// Server-side login transaction. The OAuth `state` is now an opaque handle to
/// this row rather than the caller-supplied redirect target.
model AuthTransaction {
  id                    String @id @default(uuid()) @db.Uuid
  state                 String @unique
  applicationId         String @map("application_id") @db.Uuid
  applicationProviderId String @map("application_provider_id") @db.Uuid

  codeVerifier        String  @map("code_verifier")
  codeChallengeMethod String  @default("S256") @map("code_challenge_method")
  nonce               String?

  /// Already validated against the allowlist when this row was written.
  redirectUri String @map("redirect_uri")

  /// Opaque value from the consumer app, echoed back untouched. Now that `state`
  /// belongs to us, this is where the consumer's own CSRF token lives.
  consumerState String? @map("consumer_state")

  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  application         Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationProvider ApplicationProvider @relation(fields: [applicationProviderId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("auth_transactions")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions AdminSession[]

  @@map("admin_users")
}

/// Opaque server-side session. Chosen over a JWT cookie so that logout and
/// lockout revoke immediately instead of waiting for expiry.
model AdminSession {
  id          String @id @default(uuid()) @db.Uuid
  adminUserId String @map("admin_user_id") @db.Uuid
  /// SHA-256 of the cookie value; the value itself is never stored.
  tokenHash   String @unique @map("token_hash")

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}
