{
  "name": "auth-service",
  "version": "2.0.0",
  "private": true,
  "description": "Multi-tenant OAuth2 authentication service",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "lint": "npm --prefix backend run lint",
    "build": "npm --prefix backend run build && npm --prefix frontend run build"
  }
}
